# Agent Memory Core service configuration.
# Copy to .env.service and fill in real values; never commit the real file.

MEMORY_DSN=postgresql://memory:CHANGE_ME@127.0.0.1:55432/memory
MEMORY_API_KEY=CHANGE_ME_AT_LEAST_24_CHARS
MEMORY_TENANT_ID=demo-home

# Optional retrieval indexes (canonical SQL works without them).
MEMORY_ENABLE_VECTOR=1
MEMORY_ENABLE_AGE=1

# Object bytes: local content-addressed files or S3-compatible storage.
MEMORY_OBJECT_BACKEND=local
MEMORY_OBJECT_ROOT=./data/objects

# ---------------------------------------------------------------------------
# Fact extraction provider. Optional: the whole API works without any extractor
# if callers supply structured candidates. Text-only /v1/memories/process needs
# one of the providers below.
#
#   rule            deterministic regex/templates, zero model, zero network
#   <preset>        openai | deepseek | dashscope | zhipu | vllm | ollama-openai
#                   presets fill base_url and model; set only the API key
#   custom          any OpenAI-style /chat/completions endpoint (explicit URL)
#   ollama          loopback-only native Ollama /api/generate (legacy default)
#
# Unset MEMORY_EXTRACTOR_PROVIDER to disable text extraction entirely.
# A JSON config file can hold both sections: MEMORY_PROVIDER_CONFIG=/etc/amc/providers.json
#   {"extractor": {"provider": "deepseek", "api_key": "sk-..."},
#    "embedding": {"provider": "dashscope", "dimensions": 512}}
# Environment variables override file values.
# ---------------------------------------------------------------------------
MEMORY_EXTRACTOR_PROVIDER=rule

# rule provider — no model, no network. Built-in rules are domain-neutral
# (generic likes / dislikes / allergy). Domain phrasing comes from a rule pack.
MEMORY_RULE_DEFAULT_SUBJECT=user
# A shipped preset name, or a path to your own JSON rule file:
#   {"subjects": ["客户A"], "rules": [{"name": "...", "regex": "...",
#    "predicate": "...", "value": {"key": "{group}"}, "confidence": 0.7}]}
# MEMORY_RULE_PATTERNS=home-zh
# MEMORY_RULE_PATTERNS=/etc/agent-memory/rules.json

# preset provider — one line per provider, endpoint/model come from the preset:
#   deepseek | dashscope | zhipu | openai | vllm | ollama-openai
# MEMORY_EXTRACTOR_PROVIDER=deepseek
# MEMORY_EXTRACTOR_API_KEY=sk-...
# Override any preset default:
# MEMORY_EXTRACTOR_MODEL=deepseek-chat
# MEMORY_EXTRACTOR_BASE_URL=https://api.deepseek.com/v1/chat/completions
# MEMORY_EXTRACTOR_TIMEOUT=30
# MEMORY_EXTRACTOR_JSON_MODE=1

# ollama provider (loopback only by design)
# MEMORY_EXTRACTOR_PROVIDER=ollama
# MEMORY_LOCAL_OLLAMA_MODEL=qwen2.5:7b
# MEMORY_LOCAL_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/generate

# ---------------------------------------------------------------------------
# Embedding provider. Optional but recommended: without it the semantic channel
# only works when callers compute vectors themselves.
#
# When configured, claims are vectorised on write (POST /v1/memories and
# /v1/memories/process) and queries are vectorised on search, so clients never
# need an embedding model. Provider failure never fails the canonical write:
# the response reports embedded=false and a worker can retry.
#
# The store has vector(384) and vector(512) tables only — request 384 or 512
# dimensions (text-embedding-3-*, text-embedding-v3, bge-m3 all support this).
# ---------------------------------------------------------------------------
# MEMORY_EMBEDDING_PROVIDER=dashscope
# MEMORY_EMBEDDING_API_KEY=sk-...
# MEMORY_EMBEDDING_MODEL=text-embedding-v3
# MEMORY_EMBEDDING_DIMENSIONS=512
# MEMORY_EMBEDDING_BATCH_SIZE=32
# MEMORY_EMBEDDING_TIMEOUT=30
# Self-hosted encoder on the GPU box:
# MEMORY_EMBEDDING_PROVIDER=vllm
# MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1/embeddings
# MEMORY_EMBEDDING_MODEL=bge-m3
# MEMORY_EMBEDDING_DIMENSIONS=512
# Disable server-side vectorisation while keeping the provider configured:
# MEMORY_AUTO_EMBED=0

# ---------------------------------------------------------------------------
# Optional components
# ---------------------------------------------------------------------------
# MEMORY_TEMPORAL_ADDRESS=127.0.0.1:7233
# MEMORY_TEMPORAL_NAMESPACE=default
# MEMORY_WEBHOOK_SIGNING_KEY=
# MEMORY_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# MEMORY_DB_RLS_MODE=0
