          "input": {
            "required_effect_keys": [
              "set-bedroom-target-v1"
            ]
          }
        },
        "effects": {
          "task_id": "11111111-1111-4111-8111-111111111111",
          "items": [
            {
              "effect_key": "set-bedroom-target-v1",
