FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml README.md ./
COPY src/ src/
RUN python -m pip install --no-cache-dir '.[postgres,temporal]' \
    && useradd --uid 10001 --create-home memory
USER memory
CMD ["python", "-m", "agent_memory_core.temporal_worker"]
